{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "backend": {
      "$ref": "#/definitions/component",
      "properties": {
        "env": {
          "type": "object",
          "properties": {
            "prefix": { "type": "string", "pattern": "^/" },
            "ginMode": { "type": "string", "enum": ["debug", "release", "test"] }
          }
        },
        "migration": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "frontend": { "$ref": "#/definitions/component" },
    "database": {
      "type": "object",
      "required": ["createSecret", "existingSecret", "secretKeys"],
      "properties": {
        "createSecret": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "port": { "type": ["string", "integer"] },
        "sslMode": { "type": "string", "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] },
        "secretKeys": {
          "type": "object",
          "required": ["host", "port", "name", "user", "password", "sslMode"]
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "traefik": {
      "type": "object",
      "properties": {
        "ingressRoute": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["image", "service", "resources", "autoscaling"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "required": ["registry", "repository", "tag", "pullPolicy"],
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
